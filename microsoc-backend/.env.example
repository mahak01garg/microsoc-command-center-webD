PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Approval/password-reset email
APPROVAL_EMAIL_FROM=MicroSOC <onboarding@resend.dev>
APPROVAL_REPLY_TO=your-email@example.com
RESEND_API_KEY=

# AI integrations
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/owl-alpha
OPENAI_API_KEY=
