PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Approval/password-reset email
# Use a verified sender email or authenticated domain in SendGrid.
# Examples:
# SENDGRID_FROM_EMAIL=MicroSOC <verified-sender@example.com>
# APPROVAL_EMAIL_FROM=MicroSOC <verified-sender@example.com>
SENDGRID_FROM_EMAIL=MicroSOC <verified-sender@example.com>
APPROVAL_EMAIL_FROM=MicroSOC <verified-sender@example.com>
APPROVAL_REPLY_TO=you@example.com
SENDGRID_API_KEY=

# AI integrations
# Keep AI_REQUIRE_PROVIDER=true when you want only real AI answers.
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openrouter/owl-alpha
OPENAI_API_KEY=
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=220
AI_REQUIRE_PROVIDER=true
