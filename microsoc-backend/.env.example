PORT=5001
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=https://your-frontend.vercel.app
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# Approval/password-reset email
APPROVAL_EMAIL_FROM=MicroSOC <onboarding@resend.dev>
APPROVAL_REPLY_TO=your-email@example.com
RESEND_API_KEY=

# AI integrations
# Keep AI_REQUIRE_PROVIDER=true when you want only real AI answers.
AI_PROVIDER=openai
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENAI_API_KEY=
AI_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=220
AI_REQUIRE_PROVIDER=true
